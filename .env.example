# Backend AI Service - Environment Configuration
# Copy this file to .env and adjust values as needed.
# All values below are the defaults used when .env is absent.

# ─── Core Pipeline ──────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7
TIMEOUT_SECONDS=30

# ─── spaCy / OCR Models ────────────────────────────────────────
SPACY_MODEL=en_core_web_sm
PADDLEOCR_LANG=en

# ─── Image Preprocessing ───────────────────────────────────────
PREPROCESSING_ENABLED=true
PREPROCESSING_DESKEW=true
PREPROCESSING_DENOISE=true
PREPROCESSING_NORMALIZE_CONTRAST=true

# ─── MinIO Object Storage ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=indialex-docs
MINIO_SECURE=false

# ─── RAG Chatbot - Embedding ───────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── RAG Chatbot - Vector Store ────────────────────────────────
VECTOR_INDEX_PATH=vector_store/index.faiss
VECTOR_META_PATH=vector_store/meta.pkl
VECTOR_EMBED_DIM=384

# ─── RAG Chatbot - Chunking ────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ─── RAG Chatbot - LLM (Ollama) ───────────────────────────────
LOCAL_LLM_URL=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3
LOCAL_LLM_TOP_K=5

# ─── RAG Chatbot - RBAC ───────────────────────────────────────
DEFAULT_ACCESS_ROLES=default
